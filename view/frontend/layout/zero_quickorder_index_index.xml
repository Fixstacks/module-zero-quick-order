    /quickorder: the form. Not cached: it carries the form key.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="zero.quickorder" cacheable="false" template="Zero_QuickOrder::index.phtml">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\QuickOrder\ViewModel\QuickOrder</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
